# Server-only credential used by backend-owned model sessions and content processing.
GEMINI_API_KEY=

# Gemini Live model identifier
GEMINI_MODEL=gemini-3.8-live

# Text model for course extraction, transcription, and study material generation.
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Local browser origins allowed to request the backend API.
APP_ENV=development
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Optional private gate for token and tool access, required in production.
# Generate a random value and do not put it in browser code.
DEMO_GATE_TOKEN=

# Legacy owner UUID from before accounts existed. Only used by
# `python -m app.scripts.seed_user ... --adopt-local-data`.
LOCAL_OWNER_ID=00000000-0000-4000-8000-000000000001

# Sign-up and login attempts per client per window, and login session lifetime.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300
SESSION_TTL_DAYS=30


# SQLite application database. The directory is created on first startup.
SQLITE_PATH=backend/.local/screen_tutor.sqlite3

# Local private file storage for the hackathon backend. Files are not served as
# static assets. Use a persistent private volume in deployment.
STORAGE_DIR=backend/.local/private_uploads
FILE_URL_SIGNING_SECRET=

MAX_UPLOAD_MB=250
MAX_UPLOADS_PER_CLASS=100
MAX_LECTURE_MINUTES=120
MAX_CLASS_NAME_LENGTH=100

# In-memory, per-IP token issuance limit.
LIVE_SESSION_RATE_LIMIT=5
LIVE_SESSION_RATE_WINDOW_SECONDS=60

# Numeric calculator API limit; applies per socket peer and process.
CALCULATOR_RATE_LIMIT=30
CALCULATOR_RATE_WINDOW_SECONDS=60

# Lean 4 + Mathlib proof checker. Run `lake exe cache get` in backend/lean
# before starting the API; the tracked manifest pins dependency revisions.
LEAN_TOOL_ENABLED=true
LEAN_RATE_LIMIT=3
LEAN_RATE_WINDOW_SECONDS=60
LEAN_TIMEOUT_SECONDS=30
LEAN_REQUEST_MAX_BYTES=65536
LEAN_PROJECT_DIR=backend/lean
LEAN_LAKE_EXECUTABLE=lake

# Per-user class-library limits (single-process demo defaults).
UPLOAD_RATE_LIMIT=10
UPLOAD_RATE_WINDOW_SECONDS=3600
GENERATION_RATE_LIMIT=10
GENERATION_RATE_WINDOW_SECONDS=3600

# Saved study-guide PDFs. Run backend/scripts/install-study-pdf.py once to install/cache Tectonic.
STUDY_PDF_EXECUTABLE=tectonic
STUDY_PDF_TIMEOUT_SECONDS=60

# Limits and upstream timeout.
REQUEST_BODY_MAX_BYTES=1024
LIBRARY_JSON_BODY_MAX_BYTES=1100000
GEMINI_TIMEOUT_SECONDS=10

# Serve frontend/dist from FastAPI when it exists. Vite can proxy /api in dev.
FRONTEND_DIST=frontend/dist

